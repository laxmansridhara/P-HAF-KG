{
  "vectorizer": {
    "lowercase": true,
    "strip_accents": "unicode",
    "ngram_range": [
      1,
      2
    ],
    "min_df": 2,
    "max_df": 0.98,
    "sublinear_tf": true,
    "max_features": 100000
  },
  "classifier": {
    "model": "OneVsRest LinearSVC",
    "C": 1.0,
    "max_iter": 5000,
    "n_jobs": 1
  },
  "target": "confirmed_allergens only",
  "test_type": "silver holdout; labels generated by P-HAF-KG V2.1",
  "random_seed": 42
}